      "text": "fn main () {\n    \nlet v = vec![1,2,3,4,4];\n\ndouble_values(v);\n\nprintln!(\"{:?}\",v)\n\n}\n\nfn double_value(v:Vec<i32>) {\n    \n    for i in 0..v.len() {\n        v[i]*=2;\n    }\n}",
