      "text": "Why does rust do this ?\n\nbecause we does not get\nnull pointer exception and buffer overflow errors",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why does rust do this ?\n\nbecause we does not get\nnull pointer exception and buffer overflow errors",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "lGCRR9RqvEwqOECYSl014",
      "type": "text",
