      "boundElements": null,
      "updated": 1776150589613,
      "link": null,
      "locked": false,
      "text": "C/C++ -> not memory safe because humans are expected to clean the \nheap (null pointer exception , buffer overflow)\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C/C++ -> not memory safe because humans are expected to clean the \nheap (null pointer exception , buffer overflow)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
