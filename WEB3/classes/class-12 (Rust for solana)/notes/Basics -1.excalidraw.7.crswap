      "isDeleted": false,
      "boundElements": null,
      "updated": 1776150696105,
      "link": null,
      "locked": false,
      "text": "Whenever we create variable which need to be stored in\nheap , whenever this variable goes out of scope , I  will \ndelete data in heap",
