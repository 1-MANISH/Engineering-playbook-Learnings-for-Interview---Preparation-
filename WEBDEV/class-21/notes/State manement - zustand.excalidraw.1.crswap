      "updated": 1783677076893,
      "link": null,
      "locked": false,
      "text": "on change of context variables\nonly component which using the props\nthose are changing only those\nwill re-renders\n\nas memo(Sidebar) only \nrenders once because we are not \npassing any prop to it\nand no context used at all",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "on change of context variables\nonly component which using the props\nthose are changing only those\nwill re-renders\n\nas memo(Sidebar) only \nrenders once because we are not \npassing any prop to it\nand no context used at all",
      "autoResize": true,
      "lineHeight": 1.25
    },
