      "isDeleted": false,
      "boundElements": [],
      "updated": 1783359874079,
      "link": null,
      "locked": false,
      "text": "Problem-\n\n1) If worker is talking to DB then things become less\nsafe , users might right codes to read database credentials ,\nsome malisious code they can inject\n\n2) Also worker should not runs code into their proocess\n, user can do noughty things\n\n3) In this case we need to do constant\npolling for problem submitted\nagain and again - \n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem-\n\n1) If worker is talking to DB then things become less\nsafe , users might right codes to read database credentials ,\nsome malisious code they can inject\n\n2) Also worker should not runs code into their proocess\n, user can do noughty things\n\n3) In this case we need to do constant\npolling for problem submitted\nagain and again - \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
