    {
      "id": "84Xk_NsDX9sbsu-omoasq",
      "type": "text",
      "x": 271,
      "y": 10342.5,
      "width": 770,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
