    {
      "id": "rZyz8DuEbLQi6BZu6fOG8",
      "type": "text",
      "x": 223,
      "y": 14274.5,
      "width": 939.399658203125,
      "height": 455,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
